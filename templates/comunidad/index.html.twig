{% extends 'base.html.twig' %}

{% block title %}Mis comunidades · AvisaQR{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Mis comunidades</h1>
        <a href="{{ path('app_comunidad_new') }}" class="btn btn-primary">Nueva comunidad</a>
    </div>

    {% if comunidades is empty %}
        <div class="alert alert-info">
            Todavía no tienes ninguna comunidad.
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover align-middle bg-white">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Dirección</th>
                        <th>PIN</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for comunidad in comunidades %}
                        <tr>
                            <td>{{ comunidad.nombre }}</td>
                            <td>{{ comunidad.direccion }}</td>
                            <td><code>{{ comunidad.pin }}</code></td>
                            <td class="text-end">
                                <a href="{{ path('app_comunidad_show', {'id': comunidad.id}) }}" class="btn btn-sm btn-outline-secondary">Ver</a>
                                <a href="{{ path('app_comunidad_edit', {'id': comunidad.id}) }}" class="btn btn-sm btn-outline-primary">Editar</a>
                                {{ include('comunidad/_delete_form.html.twig') }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}