{% extends 'panel/layout.html.twig' %}

{% block title %}{{ comunidad.nombre }} · AvisaQR{% endblock %}

{% block body %}
    <div class="container py-4">
        <a href="{{ path('app_comunidad_index') }}" class="small">&larr; Volver a mis comunidades</a>

        <div class="d-flex justify-content-between align-items-center my-3">
            <h1 class="h4 mb-0">{{ comunidad.nombre }}</h1>
            <div>
                <a href="{{ path('app_comunidad_edit', {'id': comunidad.id}) }}" class="btn btn-sm btn-outline-primary">Editar</a>
                {{ include('comunidad/_delete_form.html.twig') }}
               
            </div>

          

        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Dirección</dt>
                    <dd class="col-sm-9">{{ comunidad.direccion }}</dd>

                    <dt class="col-sm-3">PIN</dt>
                 <dd class="col-sm-9"><code>{{ comunidad.pin }}</code></dd>
                 
                    <dt class="col-sm-3">Página de los vecinos</dt>
                    <dd class="col-sm-9 mb-0">
                        <a href="{{ url('app_publico_comunidad', {'id': comunidad.id}) }}" target="_blank">{{ url('app_publico_comunidad', {'id': comunidad.id}) }}</a>
                    </dd>
                </dl>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
            <h2 class="h5 mb-0">Zonas</h2>
            
            <div>
                <a href="{{ path('app_comunidad_qr', {'id': comunidad.id}) }}" class="btn btn-outline-secondary btn-sm">Imprimir todos los QR</a>
                <a href="{{ path('app_zona_new', {'id': comunidad.id}) }}" class="btn btn-primary btn-sm">Nueva zona</a>
            </div>
        </div>

        {% if comunidad.zonas is empty %}
            <div class="alert alert-info">
                Esta comunidad todavía no tiene zonas. Añade el portal, el ascensor, el garaje...
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle bg-white">
                    <thead class="table-light">
                        <tr>
                            <th>Zona</th>
                            <th>Código QR</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for zona in comunidad.zonas %}
                            <tr>
                                <td>{{ zona.nombre }}</td>
                                <td>
                                    {% if zona.tieneQr %}
                                        <span class="badge text-bg-success">Sí</span>
                                    {% else %}
                                        <span class="badge text-bg-secondary">No</span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    {% if zona.tieneQr %}
                                        <a href="{{ path('app_zona_qr', {'id': zona.id}) }}" class="btn btn-sm btn-outline-secondary">QR</a>
                                    {% endif %}
                                    <a href="{{ path('app_zona_edit', {'id': zona.id}) }}" class="btn btn-sm btn-outline-primary">Editar</a>
                                    {{ include('zona/_delete_form.html.twig') }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
            <h2 class="h5 mb-0">Avisos del tablón</h2>
            <a href="{{ path('app_aviso_new', {'id': comunidad.id}) }}" class="btn btn-primary btn-sm">Nuevo aviso</a>
        </div>

        {% for aviso in comunidad.avisos %}
            <div class="card mb-2">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <strong>{{ aviso.titulo }}</strong>
                        <small class="text-muted">{{ aviso.fecha|date('d/m/Y') }}</small>
                    </div>
                    <p class="mb-2 mt-2">{{ aviso.texto|nl2br }}</p>
                    <form
                        method="post"
                        action="{{ path('app_aviso_delete', {'id': aviso.id}) }}"
                        onsubmit="return confirm('¿Seguro que quieres borrar este aviso?');"
                    >
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ aviso.id) }}">
                        <button class="btn btn-sm btn-outline-danger">Borrar</button>
                    </form>
                </div>
            </div>
        {% else %}
            <div class="alert alert-info">Esta comunidad todavía no tiene avisos.</div>
        {% endfor %}
    </div>

    
{% endblock %}
