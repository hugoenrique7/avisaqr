<form method="post" action="{{ path('app_comunidad_delete', {'id': comunidad.id}) }}" class="d-inline"
      onsubmit="return confirm('¿Seguro que quieres borrar esta comunidad?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comunidad.id) }}">
    <button class="btn btn-sm btn-outline-danger">Borrar</button>
</form>