{% extends 'panel/layout.html.twig' %}


{% block title %}Averías{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">Averías</h1>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Comunidad</th>
                    <th>Zona</th>
                    <th>Estado</th>
                    <th>Prioridad</th>
                    <th>Afectados</th>
                    <th>Reaperturas</th>
                    <th>Fecha</th>
                    <th>Fecha Resolución</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for incidencia in incidencias %}
                    <tr>
                        <td>{{ incidencia.codigo }}</td>
                        <td>{{ incidencia.zona.comunidad.nombre }}</td>
                        <td>{{ incidencia.zona.nombre }}</td>
                        <td>{{ incidencia.estado.etiqueta }}</td>
                        <td>{{ incidencia.prioridad ? incidencia.prioridad.etiqueta : '' }}</td>
                        <td>{{ incidencia.afectados|length }}</td>
                        <td>{{ incidencia.cuantidadReabierta }}</td>
                        <td>{{ incidencia.fechaCreacion|date('d/m/Y H:i') }}</td>
                        <td>{{ incidencia.fechaResolucion ? incidencia.fechaResolucion|date('d/m/Y H:i') : '' }}</td>
                        <td class="text-end">
                            <a href="{{ path('app_incidencia_show', {'id': incidencia.id}) }}" class="btn btn-sm btn-outline-primary">Ver</a>
                            <a href="{{ path('app_incidencia_edit', {'id': incidencia.id}) }}" class="btn btn-sm btn-outline-secondary">Editar</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="10">No hay averías.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
