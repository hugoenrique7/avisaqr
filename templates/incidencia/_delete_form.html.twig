<form method="post" action="{{ path('app_incidencia_delete', {'id': incidencia.id}) }}" class="d-inline" onsubmit="return confirm('¿Seguro que quieres borrar esta avería?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ incidencia.id) }}">
    <button class="btn btn-outline-danger">Borrar</button>
</form>
