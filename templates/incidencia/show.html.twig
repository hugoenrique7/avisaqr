{% extends 'panel/layout.html.twig' %}

{% block title %}Avería {{ incidencia.codigo }}{% endblock %}

{% block body %}
<h1 class="h3 mb-3">Avería {{ incidencia.codigo }}</h1>

<table class="table">
    <tbody>
        <tr><th>Comunidad</th><td>{{ incidencia.zona.comunidad.nombre }}</td></tr>
        <tr><th>Zona</th><td>{{ incidencia.zona.nombre }}</td></tr>
        <tr><th>Descripción</th><td>{{ incidencia.descripcion }}</td></tr>
        <tr><th>Piso</th><td>{{ incidencia.piso }}</td></tr>
        <tr><th>Teléfono</th><td>{{ incidencia.telefono }}</td></tr>
        <tr><th>Estado</th><td>{{ incidencia.estado.etiqueta }}</td></tr>
        <tr><th>Prioridad</th><td>{{ incidencia.prioridad ? incidencia.prioridad.etiqueta : 'Sin prioridad' }}</td></tr>
        <tr><th>Afectados</th><td>{{ incidencia.afectados|length }}</td></tr>
        <tr><th>Reaperturas</th><td>{{ incidencia.cuantidadReabierta }}</td></tr>
        <tr><th>Fecha</th><td>{{ incidencia.fechaCreacion|date('d/m/Y H:i') }}</td></tr>
        <tr><th>Fecha de resolución</th><td>{{ incidencia.fechaResolucion ? incidencia.fechaResolucion|date('d/m/Y H:i') : '' }}</td></tr>
    </tbody>
</table>

{% set mensaje = 'Avería en ' ~ incidencia.zona.comunidad.nombre ~ ', ' ~ incidencia.zona.comunidad.direccion ~ '. Zona: ' ~ incidencia.zona.nombre ~ '. ' ~ incidencia.descripcion ~ ' (código ' ~ incidencia.codigo ~ ')' %}

<a href="{{ path('app_incidencia_index') }}" class="btn btn-secondary">Volver</a>
<a href="{{ path('app_incidencia_edit', {'id': incidencia.id}) }}" class="btn btn-primary">Editar</a>
<a href="https://wa.me/?text={{ mensaje|url_encode }}" target="_blank" class="btn btn-success">Solicitar reparación</a>
{{ include('incidencia/_delete_form.html.twig') }}
{% endblock %}