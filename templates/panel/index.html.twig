{% extends 'base.html.twig' %}

{% block title %}Panel de Administador{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h4 mb-0">Hola, {{ app.user.nombre }}</h1>
            <a href="{{ path('app_logout') }}" class="btn btn-outline-secondary btn-sm">Cerrar sesión</a>
        </div>

        <p>Este es tu panel. Aquí irán tus comunidades, las averías y los avisos.</p>
    </div>
{% endblock %}
