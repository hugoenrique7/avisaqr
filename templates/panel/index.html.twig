{% extends 'panel/layout.html.twig' %}

{% block title %}Panel de Administador{% endblock %}

{% block body %}
    <div class="container">
        <h1 class="h4 mb-4">Hola, {{ app.user.nombre }}</h1>

        <div class="row g-3">
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h2 class="h6">Comunidades</h2>
                        <p class="text-muted small">Da de alta tus comunidades y sus zonas.</p>
                        <a href="{{ path('app_comunidad_index') }}" class="btn btn-primary btn-sm">Ver comunidades</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
